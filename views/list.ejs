<!doctype html><html lang="<%= lang %>"><head><%- include('head') %></head><body><%- include('nav') %><main class="portalpage"><h1><%= title %></h1><form class="dataform" method="post" action="/<%= type %>"><% fields.forEach(function(f){ %><input name="<%= f %>" placeholder="<%= f %>"><% }) %><button class="btn gold"><%= t.add %></button></form><table><thead><tr><% fields.forEach(function(f){ %><th><%= f %></th><% }) %><th></th></tr></thead><tbody><% items.forEach(function(item){ %><tr><% fields.forEach(function(f){ %><td><%= item[f] || '' %></td><% }) %><td><form method="post" action="/delete/<%= type %>/<%= item._id %>"><button class="danger"><%= t.delete %></button></form></td></tr><% }) %></tbody></table><a class="btn navy" href="/dashboard"><%= t.back %></a></main></body></html>