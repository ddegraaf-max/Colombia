<!doctype html>
<html lang="<%= lang %>">
<head><%- include('partials_head') %></head>
<body>
<%- include('partials_nav') %>
<main class="portal">
  <p class="badge">Secure Portal</p>
  <h1><%= title %></h1>
  <form class="data-form" method="post" action="/<%= type %>">
    <div class="formgrid">
      <% fields.forEach(function(field){ %>
        <% if (field === 'notes' || field === 'demand') { %>
          <textarea name="<%= field %>" placeholder="<%= field %>"></textarea>
        <% } else { %>
          <input name="<%= field %>" placeholder="<%= field %>">
        <% } %>
      <% }) %>
    </div>
    <button class="btn primary" type="submit"><%= t.add %></button>
  </form>
  <div class="tablewrap">
    <table>
      <thead><tr><% fields.forEach(function(field){ %><th><%= field %></th><% }) %><th></th></tr></thead>
      <tbody>
      <% items.forEach(function(item){ %>
        <tr>
          <% fields.forEach(function(field){ %><td><%= item[field] || '' %></td><% }) %>
          <td><form method="post" action="/delete/<%= type %>/<%= item._id %>"><button class="danger" type="submit"><%= t.delete %></button></form></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <p><a class="btn secondary" href="/dashboard"><%= t.back_dashboard %></a></p>
</main>
</body>
</html>
