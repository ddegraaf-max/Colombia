<!doctype html><html lang="<%= lang %>"><head><%- include('head') %></head><body><%- include('nav') %><main class="portalPage"><h1><%= title %></h1><form class="dataForm" method="post" action="/<%= type %>"><% fields.forEach(f=>{ %><input name="<%= f %>" placeholder="<%= f %>"><% }) %><button class="btn gold"><%= t.add %></button></form><table><thead><tr><% fields.forEach(f=>{ %><th><%= f %></th><% }) %><th></th></tr></thead><tbody><% items.forEach(item=>{ %><tr><% fields.forEach(f=>{ %><td><%= item[f]||'' %></td><% }) %><td><form method="post" action="/delete/<%= type %>/<%= item._id %>"><button class="danger"><%= t.delete %></button></form></td></tr><% }) %></tbody></table><a class="btn dark" href="/dashboard"><%= t.back %></a></main></body></html>