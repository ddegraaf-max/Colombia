<!doctype html><html lang="<%= lang %>"><head><%- include('head') %></head><body><%- include('nav') %><main class="portalpage"><div class="portalhead"><div><h1><%= t.dashboard %></h1><p><%= t.welcome %>, <%= email %>. <%= t.manage %></p></div><form method="post" action="/logout"><button class="btn navy"><%= t.logout %></button></form></div><section class="modules"><a href="/candidates"><b><%= counts.candidates %></b><span><%= t.cand %></span></a><a href="/institutions-list"><b><%= counts.institutions %></b><span><%= t.inst %></span></a><a href="/subsidies"><b><%= counts.subsidies %></b><span><%= t.subs %></span></a><a href="/documents"><b><%= counts.documents %></b><span><%= t.docs %></span></a></section><section class="docpreview"><h2><%= t.docs %></h2><% recentDocs.forEach(function(d){ %><article><h3><%= d.title %></h3><p><b><%= d.category %></b> • <%= d.language %> • <%= d.status %></p><p><%= d.notes %></p></article><% }) %></section></main></body></html>