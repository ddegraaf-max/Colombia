<!doctype html><html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard</title><%- include('partials_style') %></head><body><div class="wrap"><div class="top"><div><h1>Honor Care Poland</h1><div>Beveiligde documentenomgeving</div></div><form method="post" action="/logout"><button class="logout">Uitloggen</button></form></div><section class="panel"><h2>Documenten & websitebestanden</h2><p class="sub">Alle bestanden hieronder zijn alleen toegankelijk na wachtwoord + Authenticator-inlog.</p><div class="grid"><% files.forEach(function(file){ %><div class="file"><b><%= file.name %></b><small><%= file.path %> · <%= Math.round(file.size/1024) %> KB</small><br><a class="download" href="/download/<%= encodeURI(file.path) %>">Download</a></div><% }) %></div></section></div></body></html>
