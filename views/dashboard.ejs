<!doctype html>
<html lang="<%= lang %>">
<head><%- include('partials_head') %></head>
<body>
<%- include('partials_nav') %>
<main class="portal">
  <section class="portal-head">
    <div>
      <p class="badge">Secure Portal</p>
      <h1><%= t.dashboard %></h1>
      <p class="lead"><%= t.welcome %>, <%= email %>. <%= t.manage_text %></p>
    </div>
    <form method="post" action="/logout"><button class="btn secondary"><%= t.logout %></button></form>
  </section>
  <section class="portal-grid">
    <a class="module" href="/candidates"><b><%= counts.candidates %></b><h3><%= t.candidates %></h3><p>Colombia → Poland pipeline</p></a>
    <a class="module" href="/institutions"><b><%= counts.institutions %></b><h3><%= t.institutions %></h3><p>CRM & partnerbeheer</p></a>
    <a class="module" href="/subsidies"><b><%= counts.subsidies %></b><h3><%= t.subsidies %></h3><p>AMIF • ESF+ • FERS</p></a>
    <a class="module" href="/documents"><b><%= counts.documents %></b><h3><%= t.documents %></h3><p>Contracten & dossiers</p></a>
  </section>
</main>
</body>
</html>
