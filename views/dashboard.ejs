<!doctype html><html lang="<%= lang %>"><head><%- include('head') %></head><body><%- include('nav') %><main class="portalpage"><div class="portalhead"><div><h1><%= p.dashboard %></h1><p><%= p.welcome %>, <%= email %>. <%= p.manage %></p></div><form method="post" action="/logout"><button class="btn navy"><%= p.logout %></button></form></div><section class="modules"><a href="/candidates"><b><%= counts.candidates %></b><span><%= p.candidates %></span></a><a href="/institutions-list"><b><%= counts.institutions %></b><span><%= p.institutions %></span></a><a href="/subsidies"><b><%= counts.subsidies %></b><span><%= p.subsidies %></span></a><a href="/documents"><b><%= counts.documents %></b><span><%= p.documents %></span></a></section><section class="docpreview"><h2><%= p.documents %></h2><% recentDocs.forEach(function(d){ %><article><h3><%= d.title %></h3><p><b><%= d.category %></b> • <%= d.language %> • <%= d.status %></p><p><%= d.notes %></p></article><% }) %></section></main></body></html>