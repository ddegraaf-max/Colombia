<!doctype html>
<html lang="<%= lang %>">
<head><%- include('partials_head') %></head>
<body class="auth-bg">
<%- include('partials_nav') %>
<main class="auth-card">
  <p class="badge">Secure access</p>
  <h1><%= t.login_title %></h1>
  <p class="sub"><%= t.login_sub %></p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="/login">
    <input name="email" type="email" placeholder="<%= t.email %>" required autocomplete="username">
    <input name="password" type="password" placeholder="<%= t.password %>" required autocomplete="current-password">
    <button class="btn primary full" type="submit"><%= t.login_button %></button>
  </form>
</main>
</body>
</html>
