<!doctype html><html><head><%- include('head') %></head><body class='authbg'><%- include('nav') %><main class='login'><h1><%= t.loginTitle %></h1><p><%= t.loginSub %></p><% if(error){ %><div class='error'><%= error %></div><% } %><form method='post' action='/login'><input name='email' type='email' placeholder='<%= t.email %>' required><input name='password' type='password' placeholder='<%= t.password %>' required><button class='btn gold full'><%= t.login %></button></form></main></body></html>