<!doctype html><html lang="<%= lang %>"><head><%- include('head') %></head><body class="authbg"><%- include('nav') %><main class="login"><h1><%= p.loginTitle %></h1><p><%= p.loginSub %></p><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/login"><input name="email" type="email" placeholder="<%= p.email %>" required><input name="password" type="password" placeholder="<%= p.password %>" required><button class="btn gold full"><%= p.login %></button></form></main></body></html>