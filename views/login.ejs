<!doctype html><html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= appName %></title><%- include('partials_style') %></head><body><main class="auth"><div class="brand">Honor Care Poland</div><p class="sub">Beveiligde omgeving voor stichting, werkmaatschappij, subsidies en documenten.</p><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/login"><div class="field"><label>E-mail</label><input name="email" type="email" required autocomplete="username"></div><div class="field"><label>Wachtwoord</label><input name="password" type="password" required autocomplete="current-password"></div><button class="btn full" type="submit">Inloggen</button></form></main></body></html>
