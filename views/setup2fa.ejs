<!doctype html><html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Authenticator instellen</title><%- include('partials_style') %></head><body><main class="auth"><div class="brand">Authenticator instellen</div><p class="sub">Scan deze QR-code met Google Authenticator, Microsoft Authenticator, 1Password of Authy.</p><img class="qr" src="<%= qr %>" alt="QR code"><p class="sub">Handmatige code:</p><div class="secret"><%= secret %></div><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/setup-2fa"><div class="field"><label>6-cijferige code</label><input name="token" inputmode="numeric" required></div><button class="btn full" type="submit">Activeren</button></form></main></body></html>
