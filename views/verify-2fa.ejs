<!doctype html>
<html lang="<%= lang %>">
<head><%- include('partials_head') %></head>
<body class="auth-bg">
<main class="auth-card">
  <h1><%= t.twofa_verify %></h1>
  <p class="sub"><%= t.twofa_verify_text %></p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="/verify-2fa">
    <input name="token" placeholder="000000" required inputmode="numeric">
    <button class="btn primary full" type="submit"><%= t.verify %></button>
  </form>
</main>
</body>
</html>
