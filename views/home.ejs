<!doctype html><html lang="<%= lang %>"><head><%- include('head') %></head><body><%- include('nav') %><section class="hero"><div class="hero-copy"><h1><span><%= t.hero[0] %></span><span><%= t.hero[1] %></span><strong><%= t.hero[2] %></strong></h1><p><%= t.heroText %></p><div class="pillars"><% t.pillars.forEach(function(item){ %><div><b>✓</b><strong><%= item %></strong></div><% }) %></div><div class="actions"><a class="btn navy" href="/institutions"><%= t.inst %> →</a><a class="btn gold" href="/candidates-info"><%= t.cand %> →</a></div></div><div class="hero-people"></div><aside class="hero-side"><div class="line-art">⌂</div><p><%= t.side[0] %></p><h3><%= t.side[1] %></h3><ul><li><%= t.side[2] %></li><li><%= t.side[3] %></li><li><%= t.side[4] %></li></ul></aside></section><section class="discipline"><h3><%= t.disc %></h3><% t.specs.forEach(function(s,i){ %><div><b><%= ['⚕','♢','☤','♙','♡','⚕','⚗','✚','Ψ','＋'][i] %></b><span><%= s %></span></div><% }) %></section><section class="cards"><% t.cards.forEach(function(c,i){ %><article><div class="img img<%= i %>"></div><div class="body"><h3><%= c[0] %></h3><ul><li>✓ <%= c[1] %></li><li>✓ <%= c[2] %></li><li>✓ <%= c[3] %></li><li>✓ <%= c[4] %></li></ul><a href="<%= ['/colombia','/institutions','/candidates-info','/housing','/academy'][i] %>" class="btn navy"><%= c[5] %></a></div></article><% }) %></section><section class="partners"><h4><%= t.partners %></h4><div><span>NFZ</span><span>MEDICOVER</span><span>LUXMED</span><span>PZU ZDROWIE</span><span>CM Damiana</span></div></section><section class="bottom"><div><b>100+</b><span><%= t.stats[0] %></span></div><div><b>30+</b><span><%= t.stats[1] %></span></div><div><b>10+</b><span><%= t.stats[2] %></span></div><div><b>2</b><span><%= t.stats[3] %></span></div><h2><%= t.motto %></h2></section><footer><div><img src="/images/logo.svg" alt="Honor Care International"><p>Honor Care International Sp. z o.o.</p></div><p>POLSKA – WARSZAWA<br>ul. Prosta 69, 00-838 Warszawa<br>+48 22 307 02 70<br>info@honorcare.pl</p><p>KOLUMBIA – BOGOTÁ<br>Cra. 13 # 97 - 76, Of. 502<br>+57 601 390 82 20<br>info@honorcare.co</p></footer></body></html>