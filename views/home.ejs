<!doctype html>
<html lang="<%= lang %>">
<head><%- include('head') %></head>
<body>
<%- include('nav') %>

<section class="hero">
  <div class="hero-copy">
    <h1><span><%= t.hero1 %></span><span><%= t.hero2 %></span><strong><%= t.hero3 %></strong></h1>
    <p><%= t.heroText %></p>
    <div class="checks">
      <% t.b.forEach(function(x){ %><span>✓ <%= x %></span><% }) %>
    </div>
    <div class="actions">
      <a class="btn navy" href="/institutions-page"><%= t.cta1 %></a>
      <a class="btn gold" href="/professionals"><%= t.cta2 %></a>
      <a class="btn light" href="/contact">▣ <%= t.cta3 %></a>
    </div>
  </div>
  <div class="hero-image"></div>
</section>

<section class="specialties">
  <% t.specs.forEach(function(spec, i){ %>
    <div>
      <span><%= ['⚕','♡','♢','♙','Ψ','♿','▤','♡','⚕','＋'][i] %></span>
      <small><%= spec %></small>
    </div>
  <% }) %>
</section>

<section class="cards">
  <% ['pro','inst','academy','housing'].forEach(function(cls, i){ %>
    <article>
      <div class="card-img <%= cls %>"></div>
      <div class="card-body">
        <small><%= t.cardK[i] %></small>
        <h3><%= t.cardT[i] %></h3>
        <ul>
          <% t.cardLi[i].forEach(function(li){ %><li>✓ <%= li %></li><% }) %>
        </ul>
        <a class="btn <%= i % 2 === 0 ? 'navy' : 'gold' %>" href="<%= i===0?'/professionals':i===1?'/institutions-page':i===2?'/academy':'/housing' %>"><%= t.cardB[i] %></a>
      </div>
    </article>
  <% }) %>
</section>

<section class="poland-band">
  <div class="poland-copy">
    <small><%= t.whyK %></small>
    <h2><%= t.whyT %></h2>
    <p><%= t.whyText %></p>
    <a class="btn gold" href="/poland"><%= t.whyBtn %></a>
  </div>
  <div class="stats">
    <div><b>100+</b><span><%= t.stats[0] %></span></div>
    <div><b>30+</b><span><%= t.stats[1] %></span></div>
    <div><b>10+</b><span><%= t.stats[2] %></span></div>
    <div><b>2</b><span><%= t.stats[3] %></span></div>
  </div>
</section>

<section class="partners">
  <h4><%= t.partners %></h4>
  <div>
    <span>NFZ</span>
    <span>Medicover</span>
    <span>LUX MED</span>
    <span>PZU Zdrowie</span>
    <span>CM Damiana</span>
  </div>
</section>

<footer>
  <div>
    <a class="logo foot-logo" href="/">
      <span class="logo-emblem small"><span class="logo-heart">♥</span><span class="logo-people">● ● ●</span></span>
      <span class="logo-copy"><b>HONOR CARE</b><em>INTERNATIONAL</em></span>
    </a>
    <p><%= t.footer %></p>
  </div>
  <div><h5><%= t.home %></h5><a href="/about"><%= t.about %></a><a href="/institutions-page"><%= t.inst %></a><a href="/professionals"><%= t.pro %></a><a href="/contact"><%= t.contact %></a></div>
  <div><h5>Polska</h5><p>Warszawa</p><p>+48 22 123 45 67</p><p>info@honorcare.pl</p></div>
  <div><h5>Colombia</h5><p>Bogotá</p><p>+57 320 123 45 67</p><p>colombia@honorcareinternational.com</p></div>
</footer>
</body>
</html>
