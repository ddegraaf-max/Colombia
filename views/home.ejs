<!doctype html><html><head><%- include('head') %></head><body><%- include('nav') %><section class='hero'><div class='hero-copy'><h1><span><%= t.hero[0] %></span><span><%= t.hero[1] %></span><strong><%= t.hero[2] %></strong></h1><p><%= t.heroText %></p><div class='pillars'><% t.items.forEach(x=>{ %><div><b>✓</b><strong><%= x %></strong></div><% }) %></div><div class='actions'><a class='btn navy' href='/institutions'><%= t.instBtn %> →</a><a class='btn gold' href='/candidates-info'><%= t.candBtn %> →</a></div></div><div class='hero-people'></div><aside class='hero-side'><p>Wij starten in</p><h3>Warschau, Polen</h3><ul><li>Hoofdkantoor Warschau</li><li>Recruitment Center Bogotá</li><li>Land van talent</li></ul></aside></section><section class='discipline'><h3><%= t.disc %></h3><% t.specs.forEach(s=>{ %><div><b>⚕</b><span><%= s %></span></div><% }) %></section><section class='cards'><% t.cards.forEach((c,i)=>{ %><article><div class='img img<%= i %>'></div><div class='body'><h3><%= c[0] %></h3><ul><li>✓ <%= c[1] %></li><li>✓ <%= c[2] %></li><li>✓ <%= c[3] %></li></ul><a class='btn navy'> <%= c[5] %></a></div></article><% }) %></section><section class='bottom'><div><b>100+</b><span><%= t.stats[0] %></span></div><div><b>30+</b><span><%= t.stats[1] %></span></div><div><b>10+</b><span><%= t.stats[2] %></span></div><h2><%= t.motto %></h2></section><footer><img src='/images/logo.svg'><p>Polska – Warszawa<br>info@honorcare.pl</p></footer></body></html>