<!doctype html><html lang="<%= lang %>"><head><%- include('head') %></head><body><%- include('nav') %>
<section class="hero">
  <div class="hero-copy">
    <h1><span><%= t.hero1 %></span><span><%= t.hero2 %></span><strong><%= t.hero3 %></strong></h1>
    <p><%= t.heroText %></p>
    <div class="features">
      <% t.heroItems.forEach(function(x){ %><div><b>✓</b><span><%= x %></span></div><% }) %>
    </div>
    <div class="actions"><a class="btn navy" href="/institutions"><%= t.forInst %> →</a><a class="btn gold" href="/candidates-info"><%= t.forCandidates %> →</a></div>
  </div>
  <div class="hero-people"></div>
  <aside class="hero-side"><div class="lineart">⌂</div><p><%= t.sideTitle %></p><h3><%= t.sideCity %></h3><ul><li><%= t.side1 %></li><li><%= t.side2 %></li><li><%= t.side3 %></li></ul></aside>
</section>
<section class="discipline"><h3><%= t.disciplineTitle %></h3><% t.specs.forEach(function(s,i){ %><div><b><%= ['⚕','♢','☤','♙','♡','⚕','⚗','✚','Ψ','＋'][i] %></b><span><%= s %></span></div><% }) %></section>
<section class="cards">
  <% t.cards.forEach(function(c,i){ %>
    <article><div class="img img<%= i %>"></div><div class="body"><h3><%= c[0] %></h3><ul><li>✓ <%= c[1] %></li><li>✓ <%= c[2] %></li><li>✓ <%= c[3] %></li><li>✓ <%= c[4] %></li></ul><a href="<%= ['/colombia','/institutions','/candidates-info','/housing','/academy'][i] %>" class="btn navy"><%= c[5] %></a></div></article>
  <% }) %>
</section>
<section class="trust"><h4><%= t.partners %></h4><div><span>NFZ</span><span>MEDICOVER</span><span>LUXMED</span><span>PZU ZDROWIE</span><span>CM Damiana</span></div></section>
<section class="bottom">
  <div><b>100+</b><span><%= t.stat1 %></span></div><div><b>30+</b><span><%= t.stat2 %></span></div><div><b>10+</b><span><%= t.stat3 %></span></div><div><b>2</b><span><%= t.stat4 %></span></div>
  <h2><%= t.footerMotto %></h2>
</section>
<footer><div class="footbrand"><span class="emblem"><span>♥</span><i>●●●</i></span><b>HONOR CARE</b><em>INTERNATIONAL</em></div><p>Polska – Warszawa<br>info@honorcare.pl<br>+48 22 123 45 67</p><p>Kolumbia – Bogotá<br>colombia@honorcare.co<br>+57 320 123 45 67</p></footer>
</body></html>