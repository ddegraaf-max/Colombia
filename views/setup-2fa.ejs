<!doctype html>
<html lang="<%= lang %>">
<head><%- include('partials_head') %></head>
<body class="auth-bg">
<main class="auth-card wide">
  <h1><%= t.twofa_setup %></h1>
  <p class="sub"><%= t.twofa_setup_text %></p>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <img class="qr" src="<%= qr %>" alt="2FA QR-code">
  <p class="secret"><%= secret %></p>
  <form method="post" action="/setup-2fa">
    <input name="token" placeholder="000000" required inputmode="numeric">
    <button class="btn primary full" type="submit"><%= t.activate %></button>
  </form>
</main>
</body>
</html>
