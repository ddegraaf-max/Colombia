<!doctype html>
<html lang="<%= lang %>">
<head><%- include('partials_head') %></head>
<body>
<%- include('partials_nav') %>
<main class="page">
  <p class="eyebrow">Honor Care Poland</p>
  <h1><%= title %></h1>
  <p class="lead"><%= subtitle %></p>
  <div class="cards">
    <% cards.forEach(function(card){ %>
